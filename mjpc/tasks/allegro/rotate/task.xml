<mujoco model="Allegro Hand Sphere Rotation">
  <include file="../../common.xml"/>

  <!-- <size memory="1M"/> -->

  <option integrator="implicitfast" iterations="100" ls_iterations="50"/>

  <!-- changing contact model, default stiffness=-2500 damping=-100 -->
  <!-- pretty good, stiffness=-3000 damping=-200 -->
  <default>
    <geom solref="-5000 -500" solimp="0.999 0.999 0.01 0.5 1"/>
  </default>

  <custom>
    <!-- agent_planner 0=Sampling, 5=CEM, 7=MPPI, 8=DR Sampling, 9=DR MPPI, 10=DR CEM -->
    <!-- sampling_representation 0=zero order, 1=linear, 2=cubic -->
    <numeric name="agent_planner" data="5" />
    <numeric name="agent_horizon" data="0.6" />
    <numeric name="agent_timestep" data="0.01" />
    <numeric name="agent_policy_width" data="0.0035" />
    <numeric name="sampling_spline_points" data="2" />
    <numeric name="sampling_exploration" data="0.1" />
    <numeric name="sampling_trajectories" data="120" />
    <numeric name="sampling_representation" data="2" />
    <numeric name="robust_xfrc" data="0.004" />
    <numeric name="gradient_spline_points" data="6" />
    <numeric name="ilqg_num_rollouts" data="120" />
    <numeric name="ilqg_regularization_type" data="0" />
    <numeric name="task_risk" data="0.0" />

    <!-- trajectory -->
    <numeric name="gamma" data="1.0" />

    <!-- cem -->
    <numeric name="n_elite" data="3" />
    <numeric name="std_min" data="0.4" />

    <!-- delta control -->
    <numeric name="use_delta_action" data="1" />
    <numeric name="delta_action" data="0.1" />

    <!-- use given goal -->
    <numeric name="use_given_goal" data="0" />

    <!-- parameters start from here -->

    <!-- state noise -->
    <numeric name="residual_Sphere Rot Noise" data="0.00 0.0 0.4"/>
    <numeric name="residual_Hand Joint Noise" data="0.00 0.0 0.2" />

    <!-- [dirty] counters -->
    <numeric name="residual_Curr # Rots" data="0 0 1000000"/>
    <numeric name="residual_Best # Rots" data="0 0 1000000"/>
    <numeric name="residual_Prev # Rots" data="0 0 1000000"/>
    <numeric name="residual_Total # Rots" data="0 0 1000000"/>
    <numeric name="residual_Sec per Rot" data="0.0 0.0 60.0"/>
    <numeric name="residual_Curr Dist To Goal" data="0.0 0.0 180.0"/>
  </custom>

  <!-- Set the camera viewpoint -->
  <statistic extent="0.4" center="0 0.15 0"/>
  <visual>
    <quality shadowsize="8192"/>
    <global azimuth="150" elevation="-50"/>
  </visual>

  <!-- Set default friction coefficient -->
  <default>
    <geom friction=".3"/>
  </default>

  <!-- Create the scene, including floor and the interactive target sphere. -->
  <worldbody>
    <body name="goal" pos="-0.035 0.0 0.072" euler="0 0 3.1415927" mocap="true">
      <site name="goal_site" type="sphere" pos="0 0 0" size="0.01" rgba="1 0 0 0"/>
      <!-- <geom type="sphere" size="0.06" mass="0.1" rgba="0.1 0.5 0.5 0.5" contype="0" conaffinity="0" /> -->
      <geom type="cylinder" pos="0.0 0.0 0.0425" size="0.008 0.05" rgba="0.0 0.0 1.0 0.25" contype="0" conaffinity="0" />
      <geom type="cylinder" pos="0.0 0.0425 0.0" euler="1.5708 0.0 0.0" size="0.008 0.05"
        rgba="0.0 1.0 0.0 0.25" contype="0" conaffinity="0" />
      <geom type="cylinder" pos="0.0425 0.0 0.0" euler="0.0 1.5708 0.0" size="0.008 0.05"
        rgba="1.0 0.0 0.0 0.25" contype="0" conaffinity="0" />
    </body>
  </worldbody>

  <sensor>
    <!-- Residuals -->
    <user name="Sphere Orientation" dim="3" user="0 1.0 0 10"/>
    <user name="Sphere Angular Velocity" dim="3" user="0 0.0 0 1" />
    <user name="Grasp" dim="16" user="0 0.01 0 0.1" />
    <!-- <user name="Grasp" dim="16" user="2 0.01 0 0.1 0.1" /> -->
    <!-- <user name="Grasp" dim="16" user="6 0.01 0 0.1 0.01" /> -->
    <user name="Actuation" dim="16" user="0 0.0 0 10" />

    <!-- Measurements we want to use -->
    <!-- If objtype=body, the three cylinders in goal body will make the sensor value strange -->
    <framepos name="sphere_goal_position" objtype="site" objname="goal_site"/>
    <framequat name="sphere_goal_orientation" objtype="site" objname="goal_site"/>
  </sensor>
 
  <include file="sphere.xml" />
  <include file="right_hand_modified.xml"/>

  <keyframe>
    <key name="home" qpos="1.0 0.0 0.0 0.0 0.2 0.95 1.0 1.0 0.0 0.6 1.0 1.0 -0.2 0.95 1.0 1.0 0.6 1.95 1.0 1.0"/>
  </keyframe>
</mujoco>
